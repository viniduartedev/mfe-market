{
  "rewrites": [
    { "source": "/checkout", "destination": "/index.html" },
    { "source": "/cart", "destination": "/index.html" }
  ],
  "headers": [{ "source": "/assets/(.*)", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }, { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" }] }]
}
